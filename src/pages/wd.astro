---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 860px;
				max-width: calc(100% - 2rem);
				padding: 2rem 1rem;
			}

			.container {
				margin: 0 auto;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 10px 30px rgba(var(--gray), 18%);
			}

			.header {
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid #ebeef5;
				text-align: center;
			}

			.header h1 {
				margin-bottom: 0.5rem;
				color: #2f6fbd;
				font-size: 2rem;
			}

			.header p {
				margin: 0;
				color: #6b7280;
				font-size: 1rem;
			}

			.search-section {
				margin-bottom: 1.5rem;
			}

			.search-form {
				display: flex;
				gap: 0.75rem;
			}

			.search-input {
				min-width: 0;
				flex: 1;
				padding: 0.75rem 0.9rem;
				border: 1px solid #dcdfe6;
				border-radius: 6px;
				color: #1f2937;
				font: inherit;
				font-size: 1rem;
				line-height: 1.4;
				outline: none;
			}

			.search-input:focus {
				border-color: #409eff;
				box-shadow: 0 0 0 3px rgba(64, 158, 255, 18%);
			}

			.search-button {
				flex: 0 0 auto;
				padding: 0 1.25rem;
				border: 1px solid #409eff;
				border-radius: 6px;
				background: #409eff;
				color: #fff;
				font: inherit;
				font-size: 1rem;
				cursor: pointer;
			}

			.search-button:hover {
				background: #2f86dd;
				border-color: #2f86dd;
			}

			.result-section {
				margin-top: 1rem;
			}

			.results-list {
				display: grid;
				gap: 0.75rem;
			}

			.results-list:empty {
				display: none;
			}

			.character-card {
				padding: 0.85rem 1rem;
				border-left: 4px solid #409eff;
				border-radius: 4px;
				background-color: #f9fafc;
			}

			.character-name {
				margin-bottom: 0.25rem;
				color: #1f2937;
				font-size: 1rem;
				font-weight: 700;
			}

			.character-dialog {
				color: #43a047;
				font-size: 1.1rem;
				font-weight: 700;
			}

			.no-result {
				padding: 1rem;
				color: #909399;
				text-align: center;
			}

			@media (max-width: 560px) {
				main {
					max-width: 100%;
					padding: 1rem;
				}

				.container {
					padding: 1rem;
				}

				.header h1 {
					font-size: 1.5rem;
				}

				.search-form {
					flex-direction: column;
				}

				.search-button {
					min-height: 2.75rem;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<div class="container">
				<div class="header">
					<h1>{pageTitle}</h1>
					<p>{pageDescription}</p>
				</div>

				<div class="search-section">
					<form class="search-form" id="search-form">
						<label class="sr-only" for="character-search">角色名称或拼音首字母</label>
						<input
							class="search-input"
							id="character-search"
							type="search"
							placeholder="请输入角色名称或拼音首字母，如：龙吉公主 或 ljgz"
							autocomplete="off"
						/>
						<button class="search-button" type="submit">搜索</button>
					</form>
				</div>

				<div class="result-section" aria-live="polite">
					<div class="results-list" id="results-list"></div>
					<div class="no-result" id="empty-state">请输入角色名称或拼音首字母进行查询</div>
				</div>
			</div>
		</main>

		<template id="character-card-template">
			<div class="character-card">
				<div class="character-name"></div>
				<div class="character-dialog"></div>
			</div>
		</template>

		<script define:vars={{ charactersData }}>
			const searchForm = document.querySelector('#search-form');
			const searchInput = document.querySelector('#character-search');
			const resultsList = document.querySelector('#results-list');
			const emptyState = document.querySelector('#empty-state');
			const cardTemplate = document.querySelector('#character-card-template');

			function renderResults(results, query) {
				if (!resultsList || !emptyState || !(cardTemplate instanceof HTMLTemplateElement)) {
					return;
				}

				resultsList.replaceChildren();

				if (!query) {
					emptyState.hidden = false;
					emptyState.textContent = '请输入角色名称或拼音首字母进行查询';
					return;
				}

				if (!results.length) {
					emptyState.hidden = false;
					emptyState.textContent = '未找到匹配的角色';
					return;
				}

				emptyState.hidden = true;
				emptyState.textContent = '';

				const fragment = document.createDocumentFragment();
				results.forEach((character) => {
					const card = cardTemplate.content.cloneNode(true);
					const name = card.querySelector('.character-name');
					const dialog = card.querySelector('.character-dialog');

					if (name) name.textContent = character.name;
					if (dialog) dialog.textContent = `对话编号：${character.dialog}`;

					fragment.appendChild(card);
				});

				resultsList.appendChild(fragment);
			}

			function handleSearch() {
				if (!(searchInput instanceof HTMLInputElement)) {
					return;
				}

				const query = searchInput.value.trim().toLowerCase();
				const results = query
					? charactersData.filter((character) =>
							character.name.toLowerCase().includes(query) || character.pinyin.includes(query),
						)
					: [];

				renderResults(results, query);
			}

			searchInput?.addEventListener('input', handleSearch);
			searchForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				handleSearch();
			});
		</script>
	</body>
</html>
